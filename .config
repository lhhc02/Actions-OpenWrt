# ===== Target: MediaTek MT7981 (filogic) — Tenbay WR3000K =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tenbay_wr3000k=y

# ===== LuCI 基础 + 中文界面 =====
# 注意：25.12 的语言代码已从 zh-cn 改为 zh-hans（已核实 luci-base/po/zh_Hans）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-hans=y

# ===== 内网穿透 / 组网：Tailscale（luci feed applications，已核实存在）=====
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-hans=y

# ===== 广告拦截：AdGuard Home（luci feed applications，已核实存在）=====
CONFIG_PACKAGE_luci-app-adguardhome=y

# ===== OpenVPN（客户端+服务端管理界面）=====
# 注意：25.12 分支没有 luci-proto-openvpn（已核实不存在），用 luci-app-openvpn 替代
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y
